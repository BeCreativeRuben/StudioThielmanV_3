{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/nl/group-workshop",
      "destination": "/nl/groepsworkshop",
      "permanent": true
    },
    {
      "source": "/groepsworkshop",
      "destination": "/nl/groepsworkshop",
      "permanent": true
    },
    { "source": "/masterclass", "destination": "/nl/masterclass-ai", "permanent": true },
    { "source": "/masterclass-ai", "destination": "/nl/masterclass-ai", "permanent": true },
    { "source": "/nl/masterclass", "destination": "/nl/masterclass-ai", "permanent": true },
    { "source": "/nl/ai-masterclass", "destination": "/nl/masterclass-ai", "permanent": true },
    { "source": "/workshops", "destination": "/ai-talks", "statusCode": 301 },
    { "source": "/workshops/", "destination": "/ai-talks", "statusCode": 301 },
    { "source": "/workshops/:path*", "destination": "/ai-talks", "statusCode": 301 },
    { "source": "/nl/workshops", "destination": "/nl/ai-talks", "statusCode": 301 },
    { "source": "/nl/workshops/", "destination": "/nl/ai-talks", "statusCode": 301 },
    { "source": "/nl/workshops/:path*", "destination": "/nl/ai-talks", "statusCode": 301 },
    { "source": "/en/workshops", "destination": "/ai-talks", "statusCode": 301 },
    { "source": "/en/workshops/", "destination": "/ai-talks", "statusCode": 301 },
    { "source": "/en/workshops/:path*", "destination": "/ai-talks", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    { "source": "/admin", "destination": "/app-shell.html" },
    { "source": "/hackers-and-ravers", "destination": "/app-shell.html" },
    { "source": "/nl/hackers-and-ravers", "destination": "/app-shell.html" }
  ]
}
