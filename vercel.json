{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/nl/group-workshop",
      "destination": "/nl/groepsworkshop",
      "permanent": true
    },
    {
      "source": "/groepsworkshop",
      "destination": "/nl/groepsworkshop",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|images/|assets/|.*\\..*).*)",
      "destination": "/app-shell.html"
    }
  ]
}
