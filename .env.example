# Cal.com public booking (no OAuth / no API secret)
# Default in code: ruben-thielman-a0h3f0/30min
VITE_CAL_LINK=ruben-thielman-a0h3f0/30min
# Or full URL:
# VITE_BOOKING_URL=https://cal.com/ruben-thielman-a0h3f0/30min

# Admin login (/api/admin/login) fails closed until these are set.
# There is no default username or password.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Prefer a bcrypt hash instead of the plain password:
# ADMIN_PASSWORD_HASH=
# JWT_SECRET=   (required; login returns 500 if missing or left as change-this-secret)
